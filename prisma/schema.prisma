generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String?
  cover_image String?
  video_url   String?
  is_published Boolean @default(true)
  is_trending Boolean  @default(false)
  release_year Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  image_url   String
  link        String?
  isActive    Boolean  @default(true)
}
