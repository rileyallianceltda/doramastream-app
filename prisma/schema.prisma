generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("lead") // "lead", "admin", "client"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
